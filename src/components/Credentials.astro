---
import F from './F.astro';
import type { Content } from '../lib/content';
interface Props {
  c: Content;
}
const { c } = Astro.props;
const columns = [
  { title: c.labels.educationTitle, rows: c.education },
  { title: c.labels.recognitionTitle, rows: c.recognition },
].filter((col) => col.rows.length > 0);
---
<section class="section creds" id="education">
  <div class="wrap creds__grid" style={`--cols:${columns.length}`}>
    {columns.map((col) => (
      <div>
        <h2 class="creds__title" data-split>{col.title}</h2>
        <ul class="creds__list">
          {col.rows.map((r) => {
            const Tag = r.url ? 'a' : 'div';
            return (
              <li data-reveal>
                <Tag class="cred" {...(r.url ? { href: r.url, target: '_blank', rel: 'noopener' } : {})}>
                  <span class="cred__time mono"><F v={r.period} hint="Year" /></span>
                  <span class="cred__main">
                    <strong><F v={r.title} hint="Degree or award" /></strong>
                    <span class="cred__issuer"><F v={r.issuer} hint="Issuer" /></span>
                    {r.note && <span class="cred__note">{r.note}</span>}
                  </span>
                  {r.url && <span class="cred__arrow" aria-hidden="true">↗</span>}
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</section>
